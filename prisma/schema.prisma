// prisma/schema.prisma
// Production-grade normalized PostgreSQL schema for Namma-Connect

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  FOUNDER
  MENTOR
  INVESTOR
  ADMIN
}

enum BusinessStage {
  IDEA
  PRE_REVENUE
  EARLY_TRACTION
  GROWING
  ESTABLISHED
}

enum DiagnosticStatus {
  DRAFT
  COMPLETED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum DiagnosticFactor {
  PRODUCT
  SALES
  BRANDING
  MARKETING
  REACH
  FUNDING
}

enum GrowthPlanStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ActionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum FundingStatus {
  SAVED
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  APPROVED
}

enum CampaignType {
  PRODUCT_LAUNCH
  PRODUCT_DEMO
  FOUNDER_STORY
  CUSTOMER_STORY
  OFFER
}

enum CampaignObjective {
  PRODUCT_SALES
  AWARENESS
  LEADS
  DISCOVERY
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum NotificationType {
  MENTOR_MATCH
  FUNDING
  CAMPAIGN
  GROWTH_PLAN
  SYSTEM
}

// ----------------------------------------------------
// CORE MODELS
// ----------------------------------------------------

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role            @default(FOUNDER)
  isEmailVerified Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastLoginAt     DateTime?

  founderProfile  FounderProfile?
  mentorProfile   MentorProfile?
  businesses      Business[]
  refreshTokens   RefreshToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  mentorMatchesAsFounder MentorMatch[] @relation("FounderMatches")
  campaigns       Campaign[]
  fundingApplications FundingApplication[]

  @@index([email])
}

model FounderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phone             String?
  location          String
  state             String?
  city              String?
  preferredLanguage String   @default("English")
  bio               String?
  profileImage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id                 String        @id @default(uuid())
  founderId          String
  name               String
  category           String
  description        String
  location           String
  stage              BusinessStage @default(EARLY_TRACTION)
  monthlyRevenue     String?
  fundingRequirement String?
  website            String?
  logoUrl            String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  founder             User                 @relation(fields: [founderId], references: [id], onDelete: Cascade)
  assessments         DiagnosticAssessment[]
  growthPlans         GrowthPlan[]
  campaigns           Campaign[]
  products            MarketplaceProduct[]
  fundingApplications FundingApplication[]

  @@index([founderId])
  @@index([stage])
}

model DiagnosticAssessment {
  id               String            @id @default(uuid())
  businessId       String
  stage            BusinessStage
  status           DiagnosticStatus  @default(DRAFT)
  overallScore     Int               @default(0)
  confidence       ConfidenceLevel   @default(MEDIUM)
  confidenceReason String?
  scoringVersion   String            @default("v1")
  createdAt        DateTime          @default(now())
  completedAt      DateTime?
  updatedAt        DateTime          @updatedAt

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses    DiagnosticResponse[]
  factorScores DiagnosticFactorScore[]

  @@index([businessId])
}

model DiagnosticResponse {
  id           String           @id @default(uuid())
  assessmentId String
  factor       DiagnosticFactor
  questionKey  String
  answerKey    String
  score        Int
  createdAt    DateTime         @default(now())

  assessment DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model DiagnosticFactorScore {
  id           String           @id @default(uuid())
  assessmentId String
  factor       DiagnosticFactor
  score        Int
  weight       Float
  contribution Float
  status       String

  assessment DiagnosticAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model GrowthPlan {
  id           String           @id @default(uuid())
  businessId   String
  assessmentId String?
  title        String
  description  String
  status       GrowthPlanStatus @default(IN_PROGRESS)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actions  GrowthAction[]

  @@index([businessId])
}

model GrowthAction {
  id           String       @id @default(uuid())
  growthPlanId String
  title        String
  description  String
  factor       String
  priority     String
  week         Int
  status       ActionStatus @default(NOT_STARTED)
  completedAt  DateTime?

  growthPlan GrowthPlan @relation(fields: [growthPlanId], references: [id], onDelete: Cascade)

  @@index([growthPlanId])
}

model MentorProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  expertise        String
  industries       String
  stageExperience  String
  location         String
  languages        String
  consultationMode String   @default("Online")
  consultationFee  String   @default("Free / Pro-bono")
  bio              String
  availability     String
  verified         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches MentorMatch[]

  @@index([userId])
}

model MentorMatch {
  id           String      @id @default(uuid())
  founderId    String
  mentorId     String
  businessId   String?
  matchScore   Int
  matchReasons String      // Stored as JSON string
  status       MatchStatus @default(PENDING)
  date         String?
  timeSlot     String?
  notes        String?
  createdAt    DateTime    @default(now())

  founder User          @relation("FounderMatches", fields: [founderId], references: [id], onDelete: Cascade)
  mentor  MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([mentorId])
}

model FundingOpportunity {
  id             String   @id @default(uuid())
  name           String
  provider       String
  type           String
  amountMin      String
  amountMax      String
  eligibility    String
  industries     String
  stages         String
  location       String
  applicationUrl String?
  deadline       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications FundingApplication[]
}

model FundingApplication {
  id                   String        @id @default(uuid())
  businessId           String
  founderId            String
  fundingOpportunityId String
  status               FundingStatus @default(APPLIED)
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  founder     User               @relation(fields: [founderId], references: [id], onDelete: Cascade)
  opportunity FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@index([businessId])
}

model Campaign {
  id              String            @id @default(uuid())
  businessId      String
  founderId       String
  title           String
  description     String
  mediaUrl        String?
  productId       String?
  campaignType    CampaignType      @default(PRODUCT_LAUNCH)
  objective       CampaignObjective @default(PRODUCT_SALES)
  budget          Float             @default(500)
  dailyBudget     Float             @default(71)
  durationDays    Int               @default(7)
  status          CampaignStatus    @default(ACTIVE)
  reach           Int               @default(0)
  relevantPercent Int               @default(70)
  productViews    Int               @default(0)
  clicks          Int               @default(0)
  conversions     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  founder   User                @relation(fields: [founderId], references: [id], onDelete: Cascade)
  audience  CampaignAudience[]
  analytics CampaignAnalytics[]

  @@index([businessId])
  @@index([founderId])
}

model CampaignAudience {
  id             String @id @default(uuid())
  campaignId     String
  ageRange       String
  locations      String
  interests      String
  customerType   String
  purchaseIntent String
  category       String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignAnalytics {
  id          String   @id @default(uuid())
  campaignId  String
  impressions Int      @default(0)
  views       Int      @default(0)
  clicks      Int      @default(0)
  engagements Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  spend       Float    @default(0)
  recordedAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model MarketplaceProduct {
  id            String   @id @default(uuid())
  businessId    String
  name          String
  description   String
  category      String
  price         Float
  originalPrice Float?
  unit          String   @default("Pack of 1")
  imageUrl      String?
  stock         Int      @default(100)
  isVerified    Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
}
