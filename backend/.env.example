# ==============================================================================
# Namma-Connect FastAPI Backend - Supabase Environment Configuration Example
# ==============================================================================

# Supabase Project Connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase PostgreSQL Database URL (SQLAlchemy 2.x with psycopg3 driver)
# Session/Transaction pooler port 6543 or direct port 5432:
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Verification
JWT_AUDIENCE=authenticated
JWT_ALGORITHM=HS256

# Application Settings
PORT=5000
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173
